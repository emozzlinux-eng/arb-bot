# ============================================================
# flash-loan-arb — environment template  (v2, Base-Sepolia ready)
#
#   cp .env.example .env   &&   nano .env
#
# SECURITY RULES
#   • NEVER commit .env (it is in .gitignore — keep it that way).
#   • NEVER paste private keys directly into the terminal prompt;
#     scripts read them from THIS file only.
#   • chmod 600 .env
#   • The hot wallet (BOT_PRIVATE_KEY) should hold ONLY gas capital.
#     All profit flows to COLD_WALLET, which never touches this machine.
# ============================================================

# --- Mode -----------------------------------------------------------------
DEMO_MODE=true                 # true => mock data, no real txs. false => LIVE
LOG_LEVEL=info                 # debug | info | warn | error

# --- Chains / RPC (primary + backups; health monitor auto-switches) -------
# Get free RPCs:  https://chainlist.org  -> search your chain -> copy URL
# Better (low latency, key required): Alchemy/QuickNode/Infura dashboards -> "Create App"
# Base Sepolia faucets for test ETH: https://base.org/faucet , https://www.quicknode.com/faucet/base-testnet
CHAIN_ID=84532                 # 84532 Base Sepolia | 137 Polygon | 1 Ethereum | 8453 Base
RPC_PRIMARY=https://sepolia.base.org
RPC_BACKUP_1=https://base-sepolia-rpc.publicnode.com
RPC_BACKUP_2=https://rpc.sepolia-base.org
RPC_MAX_LATENCY_MS=200         # switch if primary p95 exceeds this

# --- Wallets (LIVE mode only; DEMO ignores these) --------------------------
# BOT_PRIVATE_KEY: export the RAW hex key (0x + 64 chars) from MetaMask:
#   Settings -> Security & Privacy -> Show private key (hot wallet ONLY!)
# COLD_WALLET: an address that only YOU control and whose key NEVER lives on
#   this laptop (hardware wallet / offline vault). Profits are swept here.
BOT_PRIVATE_KEY=
COLD_WALLET=0x0000000000000000000000000000000000000000
CONTRACT_ADDRESS=              # filled automatically by scripts/deploy.sh

# --- Protocol addresses -----------------------------------------------------
# Aave V3 deployed-pools list: https://docs.aave.org/developers/resources/deployed-contracts
# USDC on Base Sepolia: 0x036CbD53842c942c0a99C3a329cc9BdF1BB8E1A2 (faucet: https://faucet.circle.com)
# Uniswap V3 on Base Sepolia: https://docs.uniswap.org/contracts/v3/deployments
AAVE_V3_POOL=0x0000000000000000000000000000000000000000   # set to real pool before LIVE
PROFIT_TOKEN=0x036CbD53842c942c0a99C3a329cc9BdF1BB8E1A2   # USDC (Base Sepolia)
BORROW_TOKEN=0x036CbD53842c942c0a99C3a329cc9BdF1BB8E1A2   # flash-loan asset

# --- Strategy ---------------------------------------------------------------
MIN_PROFIT_USD=5               # reject any simulated arb below this net profit
MAX_LOAN_USD=50000             # cap borrowed size per attempt
SWEEP_THRESHOLD_USD=50         # auto-sweep contract profit once it crosses this
PAIRS=WETH/USDC,WBTC/WETH,USDT/WETH   # comma list scanned concurrently

# --- Gas (EIP-1559) ----------------------------------------------------------
PRIORITY_FEE_CAP_GWEI=50       # hard ceiling on tip during congestion
MAX_FEE_GWEI=500               # ceiling total fee; skip tx if base+tip > this
GAS_BUFFER_PCT=15              # safety margin added to simulated gas usage

# --- Telegram ----------------------------------------------------------------
# 1) Token: DM @BotFather -> /newbot -> copy the "123456:ABC-DEF..." string.
# 2) Chat ID: start a DM with YOUR bot (press /start), then open in a browser:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    Find "chat":{"id":<THIS NUMBER>}  -> that is TELEGRAM_CHAT_ID.
#    (Negative number = you're using a group; that works too.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Hardware guardrails (2017 MBA i5 / 8GB) ---------------------------------
MAX_CONCURRENT_SCANS=4         # pair scanner concurrency window
WS_MAX_SUBSCRIPTIONS=2         # hard cap on live websocket subs
HEAP_SOFT_LIMIT_MB=384         # bot self-restarts GC-tuned under this

# ============================================================
# CONTRACT DEPLOYMENT PARAMS (used by scripts/deploy.sh only)
# Constructor order: (aavePool, coldWallet, profitToken, borrowToken, minProfitWei)
# ============================================================
MIN_PROFIT_WEI=5000000                       # 5 USDC (6 decimals) = 5_000_000
POOL_A=0x0000000000000000000000000000000000000000    # Uniswap V3 pool address
POOL_B=0x0000000000000000000000000000000000000000    # SushiSwap pool address
POOL_A_ZFO=false                             # token0->token1 direction on pool A
POOL_B_ZFO=true                              # reverse direction on pool B
